{
	"geode": "5.10.1",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "naomii64.parallax-helper",
	"name": "parallax helper",
	"version": "1.0.0",
	"developer": "naomii64",
	"description": "A mod that manages parallax effects in levels to make it easier.",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3",
		"alphalaneous.alphas-ui-pack": ">=v1.4.0",
		"nwo5.silly-api": ">=2.1.0"
	},
	"resources": {
		"sprites": [
			"resources/*.png"
		]
	},
	"settings": {
		"title-colors": {
		    "type": "title",
		    "name": "Colors"
		},
		"depth-label-color-default": {
			"type": "rgb",
			"name": "Default Depth Color",
			"default": [255,255,255]
		},
		"depth-label-color-negative": {
			"type": "rgb",	
			"name": "Negative Depth Color",
			"default": [170,215,255]
		},
		"depth-label-color-positive": {
			"type": "rgb",
			"name": "Positive Depth Color",
			"default": [255,170,170]
		},

		"title-keybinds": {
		    "type": "title",
		    "name": "Keybinds"
		},
		"keybind-layerlist-up": {
			"type":"keybind",
			"name":"Up Layer List",
			"default":["Up"],
			"category": "editor",
			"allow-in-text-inputs":true
		},
		"keybind-layerlist-down": {
			"type":"keybind",
			"name":"Down layer List",
			"default":["Down"],
			"category": "editor",
			"allow-in-text-inputs":true
		},
		
		"title-default-center-objects": {
		    "type": "title",
		    "name": "Center Object Settings"
		},
		"int-root-object-ID": {
    		"type": "int",
    		"name": "Root Object ID",
			"default": 3816,
			"description": "default is 3816 or particle face"
		},
		"float-root-object-scale": {
    		"type": "float",
    		"name": "Root Object scale",
			"default":0.5,

			"min": 0.0,
    		"max": 4.0,
			"control": {
        		"arrows": true,
        		"arrow-step": 0.1,
				
				"slider": true,
        		"slider-step": 0.1
    		}
		},
		"int-follow-object-ID": {
    		"type": "int",
    		"name": "Follow Object ID",
			"default": 3805,
			"description": "default is 3805 or particle square"
		},
		"float-follow-object-scale": {
    		"type": "float",
    		"name": "follow Object scale",
			"default":1.0,

			
			"min": 0.0,
    		"max": 4.0,
			"control": {
        		"arrows": true,
        		"arrow-step": 0.1,
				
				"slider": true,
        		"slider-step": 0.1
    		}
		}
	}
}