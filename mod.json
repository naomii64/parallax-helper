{
	"geode": "5.10.1",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "naomii64.parallax-helper",
	"name": "parallax helper",
	"version": "1.0.0",
	"developer": "naomii64",
	"description": "A mod that manages parallax effects in levels to make it easier.",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3",
		"alphalaneous.alphas-ui-pack": ">=v1.3.4",
		"nwo5.silly-api": ">=2.0.1"
	},
	"resources": {
		"sprites": [
			"resources/*.png"
		]
	},
	"settings": {
		"depth-label-color-default": {
			"type": "rgb",
			"name": "Default Depth Color",
			"default": [255,255,255]
		},
		"depth-label-color-negative": {
			"type": "rgb",	
			"name": "Negative Depth Color",
			"default": [170,215,255]
		},
		"depth-label-color-positive": {
			"type": "rgb",
			"name": "Positive Depth Color",
			"default": [255,170,170]
		},


		"keybind-layerlist-up": {
			"type":"keybind",
			"name":"Up Layer List",
			"default":["Up"],
			"category": "editor",
			"allow-in-text-inputs":true
		},
		"keybind-layerlist-down": {
			"type":"keybind",
			"name":"Down layer List",
			"default":["Down"],
			"category": "editor",
			"allow-in-text-inputs":true
		}
	}
}
